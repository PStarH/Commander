# =============================================================================
# Commander — Environment Configuration
# Copy to .env and fill in your values.
# Set at minimum ONE LLM provider API key.
# =============================================================================

# ── LLM Provider (set at least one) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
MIMO_API_KEY=
XIAOMI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
CO_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
ANYSCALE_API_KEY=
DEEPINFRA_API_KEY=
AGNES_API_KEY=
STEPFUN_API_KEY=
MINIMAX_API_KEY=
AZURE_OPENAI_API_KEY=

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com
# AZURE_OPENAI_MODEL=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-06-01

# ── Local / Self-hosted Providers ─────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# VLLM_BASE_URL=http://localhost:8000/v1

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Cloud Replicate ───────────────────────────────────────────────────────────
# REPLICATE_API_TOKEN=

# ── Default Provider Settings ─────────────────────────────────────────────────
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ── Distributed EventBus ─────────────────────────────────────────────────────
# Local-first default: in-memory EventBus (no external dep).
# Set to `redis` for cross-node fan-out (requires the `distributed` compose
# profile: docker compose --profile distributed up).
# COMMANDER_EVENT_BUS_BACKEND=memory
# COMMANDER_EVENT_BUS_REDIS_URL=redis://redis:6379

# ── Observability (opt-in via compose profiles) ─────────────────────────────
# Tracing is enabled by default and exports to an OTLP-compatible collector.
# Point the OTLP exporter at the Jaeger collector (compose `tracing` profile).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# To disable the built-in OTLP exporter entirely, set this to false.
# COMMANDER_OTEL_ENABLED=false
# Grafana admin password (compose `observability` profile). Change in production.
# GRAFANA_ADMIN_PASSWORD=admin

# ── HTTP Server ───────────────────────────────────────────────────────────────
# REQUIRED for production: a strong random secret (≥32 chars, generated with
# `openssl rand -hex 32` or a secret manager). The API refuses to start when it
# is missing, and Commander presents it to the Action Gateway as its own
# credential. It is NOT the inbound request key: inbound requests authenticate
# with an API key issued into PostgreSQL (`X-API-Key: <key>` or
# `Authorization: Bearer <key>`) or with a JWT. Leaving this unset or using the
# placeholder below is a launch blocker.
COMMANDER_API_KEY=change-me-to-a-random-secret
# Required API startup credentials. The API refuses to start if any is missing.
# Generate each with `openssl rand -hex 32`, and use a password-manager-generated
# ADMIN_PASSWORD of at least 16 characters.
#   COMMANDER_MASTER_KEY           — master key for the encrypted secrets vault
#   JWT_SECRET                     — HS256 signing key for access/refresh tokens
#   COMMANDER_CAPABILITY_TOKEN_KEY — HMAC key for tool-call capability tokens;
#                                    without it, approval tokens use an insecure dev key
#   COMMANDER_INTEGRITY_KEY        — HMAC key for WAL event signing / tamper evidence
#   ADMIN_PASSWORD                 — initial admin account password
COMMANDER_MASTER_KEY=
JWT_SECRET=
COMMANDER_CAPABILITY_TOKEN_KEY=
COMMANDER_INTEGRITY_KEY=
ADMIN_PASSWORD=
PORT=4000
# Direct API processes bind to loopback by default. Docker and Helm set this to
# 0.0.0.0 so their service networking remains reachable.
API_HOST=127.0.0.1
# CORS origins — comma-separated list. NEVER use '*' in production.
# CORS_ORIGINS=http://localhost:5173,https://app.example.com

# ── Multi-tenant Settings ─────────────────────────────────────────────────────
# TENANT_PROVIDER=null      # null = single-tenant (default)
# TENANT_PROVIDER=simple    # simple = static config from file
# TENANT_CONFIG_PATH=./config/tenants.json

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Requests allowed per 60-second window. The window itself is fixed at 60s.
# API_RATE_LIMIT=120          # default for every scope
# API_RATE_LIMIT_USER=120     # per user; defaults to API_RATE_LIMIT
# API_RATE_LIMIT_TENANT=120   # per tenant; defaults to API_RATE_LIMIT

# ── Database Backend ──────────────────────────────────────────────────────────
# Local-first default: sqlite (file-backed, no external dependency).
# Valid API_STORE_BACKEND values: sqlite | memory | postgres.
# Set to `postgres` and provide DATABASE_URL to use the managed PostgreSQL
# service (compose `database` profile: docker compose --profile database up).
# API_STORE_BACKEND=sqlite
# DATABASE_URL=
# POSTGRES_USER=commander
# REQUIRED by the compose `database`, `v2`, and `cell` profiles — compose fails
# fast when it is unset (`POSTGRES_PASSWORD:?set POSTGRES_PASSWORD`). This is the
# PostgreSQL superuser used at init; the app/scheduler/worker/owner roles are
# created by deploy/docker/postgres-init.bench.sql.
POSTGRES_PASSWORD=
# POSTGRES_DB=commander
# Task-1 tenant-authority closure phase applied by the owner migration
# (compose `kernel-migrate`, the Helm owner Job). Defaults to `enforce`, the
# fresh-install phase. A legacy upgrade that must sequence the `expand` phase
# before `enforce` sets `expand` for the first migration run, then `enforce`.
# Leaving this unset is correct for a fresh install; the owner migration still
# applies the closure, and the API cannot boot without it.
# COMMANDER_TENANT_AUTHORITY_CUTOVER_PHASE=enforce

# ── Architecture V2 Shared Kernel ─────────────────────────────────────────────
# Enable the Postgres-backed shared execution kernel. Required for worker plane.
# COMMANDER_KERNEL_ENABLED=0
# Defaults to DATABASE_URL when empty.
# COMMANDER_KERNEL_DATABASE_URL=

# ── Kernel-on database TLS (compose `v2` and `cell` profiles) ──────────────────
# The kernel never connects with `sslmode=require`: `createVerifiedPostgresPool`
# (packages/postgres-runtime) is the only sanctioned pool factory and it verifies
# the CA, the DSN hostname, and a pinned server public key. The api, worker,
# kernel-ops and kernel-migrate services each build one, so without this material
# they exit at startup with COMMANDER_DATABASE_TLS_CA_FILE_REQUIRED.
#
# Generate the material and export both variables before `pnpm docker:v2` /
# `pnpm docker:cell` (the generator prints the exact export lines):
#   sh deploy/docker/kernel-tls/generate-certificates.sh ./.commander/db-tls
#
# REQUIRED by the `v2` and `cell` profiles. Left empty here because the material
# is per-deployment; the profile fails fast when either is unset.
COMMANDER_DATABASE_TLS_HOST_DIR=
COMMANDER_DATABASE_TLS_EXPECTED_SERVER_SPKI_SHA256=
# Optional: override a role DSN if you rotated the bench role passwords
# (deploy/docker/postgres-init.bench.sql). Each must carry sslmode=verify-full
# and use the `postgres` compose service host.
# COMMANDER_API_TLS_DSN=
# COMMANDER_WORKER_TLS_DSN=
# COMMANDER_SCHEDULER_TLS_DSN=
# COMMANDER_OWNER_TLS_DSN=
# COMMANDER_ADAPTER_OPS_TLS_DSN=


# ── Sandbox ───────────────────────────────────────────────────────────────────
# Default: fail closed if no OS-level sandbox (seatbelt/bwrap/docker/gvisor) is
# available. Set to true ONLY for local development or trusted environments.
# COMMANDER_ALLOW_NO_SANDBOX=false

# Require Bearer auth on /health, /health/detailed, /ready, and /metrics.
# Default is false so load-balancer probes work out of the box. Enable in
# production if these endpoints expose sensitive data.
# COMMANDER_AUTH_PROTECT_HEALTH=false

# ── Worker / adapter-ops authority (Ed25519) ──────────────────────────────────
# REQUIRED by the compose `worker`, `v2`, and `cell` profiles (the v2/cell
# overrides re-impose `${VAR:?}`). The base single-box `docker compose up`
# starts only `api` and does not read these. Generate with the scripts in
# docs/deploy.md or `openssl genpkey -algorithm ed25519`. Worker and
# adapter-ops authority is Ed25519 PEM/JWKS/key id — never the HMAC
# COMMANDER_CAPABILITY_TOKEN_KEY (that is API-surface only).
COMMANDER_CAPABILITY_PRIVATE_KEY_PEM=
COMMANDER_CAPABILITY_KEY_ID=
COMMANDER_CAPABILITY_JWKS_JSON=
COMMANDER_EVIDENCE_SIGNING_PRIVATE_KEY_PEM=
COMMANDER_EVIDENCE_SIGNING_KEY_ID=

# ── Worker Plane (compose `worker` profile) ───────────────────────────────────
# Authentication token presented by workers when registering with the API.
# REQUIRED by the `cell` profile (compose re-imposes the required guard there).
COMMANDER_WORKER_AUTH_TOKEN=
# Subject claim used in worker authentication.
# COMMANDER_WORKER_AUTH_SUBJECT=worker
# Comma-separated capability list: agent,tool,connector.
# COMMANDER_WORKER_CAPABILITIES=agent,tool,connector
# Maximum concurrent step executions per worker process.
# COMMANDER_WORKER_MAX_CONCURRENCY=10
# Comma-separated tenant allowlist. MUST be an explicit list — never '*'.
# Worker bootstrap rejects '*', empty, and comma-only values (see
# packages/worker-plane/src/bootstrap.ts).
# COMMANDER_WORKER_TENANTS=tenant-local
# Lease time-to-live in milliseconds.
# COMMANDER_WORKER_LEASE_TTL_MS=30000
# Heartbeat interval in milliseconds.
# COMMANDER_WORKER_HEARTBEAT_MS=10000
# Poll interval for claiming work in milliseconds.
# COMMANDER_WORKER_POLL_MS=250
# Seed for deterministic effect-broker policy decisions.
# COMMANDER_EFFECT_BROKER_SEED=

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=info            # debug | info | warn | error
# LOG_FORMAT=json           # json | text

# ── Event Sourcing WAL ────────────────────────────────────────────────────────
# Path to the Write-Ahead Log used for deterministic replay and recovery.
# Default: .commander_state/event-sourcing.wal
# COMMANDER_EVENT_SOURCING_WAL=.commander_state/event-sourcing.wal

# ── Log Persistence ───────────────────────────────────────────────────────────
# Persist structured logs to SQLite. Default: false (in-memory only).
# COMMANDER_LOG_PERSIST=false

# ── Model Routing (AI-8) ─────────────────────────────────────────────────────
# Minimum model tier for security-sensitive / effect-authorizing steps (steps
# with a capability token or effect-capable tools such as payment/deploy/exec).
# Keyword-based complexity scoring reads the untrusted goal text, so without a
# floor a crafted goal could route a sensitive step to a weak model.
# One of: eco | standard | power | consensus. Default: standard.
# COMMANDER_MIN_SENSITIVE_MODEL_TIER=standard

# ── MCP Command Allowlist ─────────────────────────────────────────────────────
# Comma-separated list of additional allowed base commands for MCP stdio servers.
# npx is always forbidden. Default allows: node, python, python3, uvx, bun, deno.
# COMMANDER_MCP_ALLOWED_COMMANDS=
