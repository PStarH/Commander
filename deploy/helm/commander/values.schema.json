{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Commander Helm Values",
  "type": "object",
  "additionalProperties": true,
  "required": ["tier"],
  "definitions": {
    "databaseRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["owner", "app", "tenant-authority", "scheduler", "worker", "adapter-ops"]
      }
    },
    "databaseEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": { "$ref": "#/definitions/databaseRoles" },
        "cidr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr", "port"],
          "properties": {
            "cidr": {
              "type": "string",
              "pattern": "^(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32|[0-9A-Fa-f:]+/128)$"
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name", "servicePort", "targetPort", "podSelector"],
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "podSelector": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^(?:[a-z0-9](?:[-a-z0-9.]{0,251}[a-z0-9])?/)?[A-Za-z0-9](?:[-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9](?:[-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?)?$"
              }
            }
          }
        }
      },
      "oneOf": [
        { "required": ["cidr"] },
        { "required": ["service"] }
      ]
    }
  },
  "properties": {
    "tier": {
      "type": "string",
      "enum": ["demo", "team", "enterprise"]
    },
    "image": {
      "type": "object",
      "properties": {
        "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" }
      }
    },
    "tenantAuthority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transportBootstrap": { "type": "boolean", "default": false },
        "cutoverPhase": { "type": "string", "enum": ["expand", "enforce"] },
        "configurationSha256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "chartContentSha256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "proofOwnerSecret": { "type": "string", "pattern": "^$|^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "releaseProjectionConfigMap": { "type": "string", "pattern": "^$|^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "bootstrapAuthoritySecret": { "type": "string", "pattern": "^$|^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "allowedTenants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "expectedMigrationDescriptors": { "type": "string", "minLength": 2 },
        "apiProof": {
          "type": "object",
          "properties": {
            "publicSecret": { "type": "string" },
            "privateSecret": { "type": "string" },
            "caKey": { "type": "string", "minLength": 1 },
            "certKey": { "type": "string", "minLength": 1 },
            "keyKey": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "const": 9443 }
          }
        }
      }
    },
    "sandboxd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backend": { "type": "string", "enum": ["sqlite", "postgres"] },
        "postgres": {
          "type": "object",
          "properties": {
            "bundled": { "type": "boolean" },
            "password": { "type": "string", "maxLength": 0 },
            "existingSecret": { "type": "string" },
            "ownerSecretKey": { "type": "string", "minLength": 1 },
            "appSecretKey": { "type": "string", "minLength": 1 },
            "tenantAuthoritySecretKey": { "type": "string", "minLength": 1 },
            "schedulerSecretKey": { "type": "string", "minLength": 1 },
            "workerSecretKey": { "type": "string", "minLength": 1 },
            "adapterOpsSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "databaseTls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "caSecret": { "type": "string" },
        "caKey": { "type": "string", "minLength": 1 },
        "certKey": { "type": "string", "minLength": 1 },
        "keyKey": { "type": "string", "minLength": 1 },
        "expectedServerSpkiSha256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" }
      },
      "required": ["existingSecret", "caSecret", "caKey", "certKey", "keyKey", "expectedServerSpkiSha256"]
    },
    "worker": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "authTokenSecret": { "type": "string" }
      }
    },
    "kernelOps": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "adapterOps": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "claimSecretDir": { "type": "string", "minLength": 1 },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 1 }
          }
        },
        "secrets": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" }
          }
        },
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cluster", "namespaces", "server", "tokenEnv", "tokenSecretKey", "apiPort"],
          "properties": {
            "cluster": {
              "type": "string",
              "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
            },
            "namespaces": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                "maxLength": 63
              }
            },
            "server": { "type": "string", "pattern": "^$|^https://[^/?#]+/?$" },
            "tokenEnv": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
            "tokenSecretKey": { "type": "string", "minLength": 1 },
            "apiPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "cluster": { "minLength": 1 } },
                "required": ["cluster"]
              },
              "then": {
                "properties": {
                  "server": { "minLength": 1 },
                  "namespaces": { "minItems": 1 }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kubernetes": {
                "properties": { "cluster": { "minLength": 1 } },
                "required": ["cluster"]
              }
            },
            "required": ["kubernetes"]
          },
          "then": {
            "properties": {
              "secrets": {
                "properties": { "existingSecret": { "minLength": 1 } },
                "required": ["existingSecret"]
              }
            },
            "required": ["secrets"]
          }
        }
      ]
    },
    "api": {
      "type": "object",
      "properties": {
        "secrets": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32|[0-9A-Fa-f:]+/128)$"
          }
        },
        "clusterDns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "podSelector"],
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "podSelector": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "databaseEndpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/databaseEndpoint" }
        },
        "egress": {
          "type": "object",
          "properties": {
            "adapterCidrs": {
              "type": "array",
              "items": { "type": "string", "not": { "const": "0.0.0.0/0" } }
            },
            "kubernetesApiCidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32|[0-9A-Fa-f:]+/128)$"
              }
            },
            "databaseCidrs": {
              "type": "array",
              "items": { "type": "string", "not": { "const": "0.0.0.0/0" } }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "required": ["databaseEndpoints"],
            "properties": {
              "databaseEndpoints": {
                "minItems": 1,
                "allOf": [
                  { "contains": { "properties": { "roles": { "contains": { "const": "owner" } } }, "required": ["roles"] } },
                  { "contains": { "properties": { "roles": { "contains": { "const": "app" } } }, "required": ["roles"] } },
                  { "contains": { "properties": { "roles": { "contains": { "const": "tenant-authority" } } }, "required": ["roles"] } },
                  { "contains": { "properties": { "roles": { "contains": { "const": "scheduler" } } }, "required": ["roles"] } },
                  { "contains": { "properties": { "roles": { "contains": { "const": "worker" } } }, "required": ["roles"] } },
                  { "contains": { "properties": { "roles": { "contains": { "const": "adapter-ops" } } }, "required": ["roles"] } }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "tier": { "const": "enterprise" } } },
      "then": {
        "properties": {
          "database": {
            "properties": {
              "postgres": {
                "properties": {
                  "bundled": { "const": false },
                  "existingSecret": { "minLength": 1 }
                },
                "required": ["bundled", "existingSecret"]
              }
            }
          },
          "worker": {
            "properties": {
              "enabled": { "const": true },
              "authTokenSecret": { "minLength": 1 }
            },
            "required": ["enabled", "authTokenSecret"]
          },
          "kernelOps": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "adapterOps": {
            "properties": {
              "enabled": { "const": true },
              "secrets": {
                "properties": { "existingSecret": { "minLength": 1 } },
                "required": ["existingSecret"]
              }
            },
            "required": ["enabled", "secrets"]
          },
          "capability": {
            "properties": {
              "existingSecret": { "minLength": 1 },
              "create": { "const": false }
            },
            "required": ["existingSecret", "create"]
          },
          "evidenceSigning": {
            "properties": {
              "existingSecret": { "minLength": 1 },
              "create": { "const": false }
            },
            "required": ["existingSecret", "create"]
          }
        }
      }
    }
  ]
}
